 var api=(new Function('readState_','PropertiesService',SATORI_BOT_SANDBOX_SOURCE_+';return SatoriBotApi;'))(readState_,adapter);
 function call(action,payload){var body={keyId:keyId,timestamp:Date.now(),nonce:Utilities.getUuid(),action:action,payload:payload||{}};body.signature=Utilities.computeHmacSha256Signature([body.keyId,body.timestamp,body.nonce,body.action,JSON.stringify(body.payload)].join('\n'),secret,Utilities.Charset.UTF_8).map(function(n){return ('0'+(n&255).toString(16)).slice(-2);}).join('');return JSON.parse(api.handle({postData:{contents:JSON.stringify(body)}}).getContent());}
