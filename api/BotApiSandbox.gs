function satoriBotProductionReadOnlySmokeTest() {
 requireOwner_();
 var props=PropertiesService.getScriptProperties(),id=props.getProperty('STATE_FILE_ID');
 function bytes(){return DriveApp.getFileById(id).getBlob().getDataAsString();}
 var before=bytes(),state=JSON.parse(before),keyId='readonly-'+Utilities.getUuid(),secret=Utilities.getUuid()+Utilities.getUuid();
 var clients={};clients[keyId]={enabled:true,secret:secret,scopes:['orders:read','customers:read','debt:read']};
