 console.log(JSON.stringify({ok:true,test:'owner-runtime authenticated API handler; not public HTTP',revision:status.revision,totalOrders:status.data.orders,customerProfiles:customers.data.profiles.total,matchedOrders:orders.data.totalMatches,listedOrders:orders.data.orders.length,debtInvoices:debt.data.orders,productionUnchanged:true}));
